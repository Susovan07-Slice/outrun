{
  "name": "outrun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outrun: Global Climate-Pressure and Corridor Platform for MIGRATORY BIRDS ONLY (class Aves)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest/index.ts",
    "test": "vitest run",
    "wrangler:dev": "wrangler dev",
    "d1:init": "wrangler d1 execute outrun-db --local --file=db/schema.sql",
    "d1:seed": "python scripts/seed_d1.py",
    "snapshot:weather": "tsx scripts/snapshot_weather.ts",
    "precompute:climate": "tsx scripts/precompute/climate-grid.ts",
    "precompute:corridor": "tsx scripts/precompute/corridor-analysis.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.27",
    "@deck.gl/geo-layers": "^9.0.27",
    "@deck.gl/react": "^9.0.27",
    "date-fns": "^2.28.0",
    "deck.gl": "^9.0.27",
    "graphology": "^0.26.0",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^4.5.2",
    "rainbow-colors": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.1.3",
    "wrangler": "^3.80.0"
  }
}
